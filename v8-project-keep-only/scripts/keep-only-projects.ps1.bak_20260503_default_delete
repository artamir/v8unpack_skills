<#
.SYNOPSIS
    Keep only selected projects in v8.projects.json and remove all others.
.PARAMETER Projects
    List of projects to keep. Supports array or comma-separated string.
.PARAMETER DeleteFolders
    If set, remove folders of deleted projects (src/build/temp/current).
.PARAMETER Force
    Do not ask for confirmation.
#>
param(
    [Parameter(Mandatory=$true)]
    [string[]]$Projects,

    [switch]$DeleteFolders,

    [switch]$Force
)

$ErrorActionPreference = 'Stop'

$RootDir = Split-Path -Parent (Split-Path -Parent (Split-Path -Parent (Split-Path -Parent $PSScriptRoot)))
$JsonPath = Join-Path $RootDir "v8.projects.json"

if (-not (Test-Path $JsonPath)) {
    Write-Error "File not found: $JsonPath"
    exit 1
}

# Support format: -Projects "A,B,C"
if ($Projects.Count -eq 1 -and $Projects[0] -match ',') {
    $Projects = $Projects[0].Split(',')
}

$keepSet = @{}
foreach ($p in $Projects) {
    $name = $p.Trim()
    if ($name) {
        $keepSet[$name] = $true
    }
}

if ($keepSet.Count -eq 0) {
    Write-Error "Projects list is empty."
    exit 1
}

$jsonText = Get-Content $JsonPath -Raw -Encoding UTF8
$json = $jsonText | ConvertFrom-Json

if (-not $json.projects) {
    Write-Error "Missing 'projects' section in v8.projects.json."
    exit 1
}

$allProjectNames = @($json.projects.PSObject.Properties.Name)

# Validate: every project in keepSet must exist
$missing = @()
foreach ($k in $keepSet.Keys) {
    if ($allProjectNames -notcontains $k) {
        $missing += $k
    }
}
if ($missing.Count -gt 0) {
    Write-Error ("Projects not found in v8.projects.json: " + ($missing -join ', '))
    exit 1
}

$toRemove = @()
foreach ($name in $allProjectNames) {
    if (-not $keepSet.ContainsKey($name)) {
        $toRemove += $name
    }
}

if ($toRemove.Count -eq 0) {
    Write-Host "Nothing to remove: only requested projects are already present." -ForegroundColor Green
    exit 0
}

$foldersToDelete = @()
if ($DeleteFolders) {
    foreach ($name in $toRemove) {
        $proj = $json.projects.$name
        foreach ($key in @('src','build','temp','current')) {
            $rel = $proj.$key
            if ($rel) {
                $abs = Join-Path $RootDir $rel
                if ($key -eq 'current') {
                    $abs = Split-Path -Parent $abs
                }
                $foldersToDelete += $abs
            }
        }
    }
    $foldersToDelete = $foldersToDelete | Select-Object -Unique
}

if (-not $Force) {
    Write-Host ""
    Write-Host "Planned actions:" -ForegroundColor Yellow
    Write-Host ("  - Keep projects: " + (($keepSet.Keys | Sort-Object) -join ', '))
    Write-Host ("  - Remove projects: " + (($toRemove | Sort-Object) -join ', ')) -ForegroundColor Red
    if ($foldersToDelete.Count -gt 0) {
        Write-Host "  - Remove folders:" -ForegroundColor Red
        foreach ($f in $foldersToDelete) {
            Write-Host "      $f" -ForegroundColor Red
        }
    }
    $confirm = Read-Host "Continue? (y/N)"
    if ($confirm -notmatch '^[Yy]$') {
        Write-Host "Canceled." -ForegroundColor Gray
        exit 0
    }
}

# Backup before update
$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$backupPath = "$JsonPath.bak_$timestamp"
Copy-Item -Path $JsonPath -Destination $backupPath -Force
Write-Host "Backup created: $backupPath" -ForegroundColor DarkGray

if ($DeleteFolders) {
    foreach ($f in $foldersToDelete) {
        if (Test-Path $f) {
            Remove-Item -Recurse -Force $f
            Write-Host "Folder removed: $f" -ForegroundColor DarkYellow
        } else {
            Write-Host "Folder does not exist (skipped): $f" -ForegroundColor Gray
        }
    }
}

foreach ($name in $toRemove) {
    $json.projects.PSObject.Properties.Remove($name)
}

$jsonOut = $json | ConvertTo-Json -Depth 20
[System.IO.File]::WriteAllText($JsonPath, $jsonOut, [System.Text.Encoding]::UTF8)

Write-Host ""
Write-Host ("Done. Kept projects: " + (($keepSet.Keys | Sort-Object) -join ', ')) -ForegroundColor Green
Write-Host ("Removed projects: " + (($toRemove | Sort-Object) -join ', ')) -ForegroundColor Green
