def get_etalon_props_block(enum_dir=None):
    print("[DEBUG] Используется захардкоженный эталонный props-блок!")
    from copy import deepcopy
    return deepcopy(ETALON_PROPS_BLOCK)

def create_enum(enum_dir, name, name_ru, values):
    guid_enum = gen_guid()
    guid_values = [gen_guid() for _ in values]
    guid_block = gen_guid()
    props_block = get_etalon_props_block(enum_dir)
    header = [
        "1",
        [
            "20",
            guid_enum,
            guid_enum,
            "00000000-0000-0000-0000-000000000000",
            "00000000-0000-0000-0000-000000000000",
            [
                "0",
                [
                    "3",
                    ["1", "0", name],
                    name,
                    ["1", "\"ru\"", name_ru],
                    "",
                    "0",
                    "0",
                    "00000000-0000-0000-0000-000000000000",
                    "0"
                ]
            ],
            "1",
            "00000000-0000-0000-0000-000000000000",
            "00000000-0000-0000-0000-000000000000",
            "00000000-0000-0000-0000-000000000000",
            "00000000-0000-0000-0000-000000000000",
            str(len(values)),
            "1",
            "00000000-0000-0000-0000-000000000000",
            "00000000-0000-0000-0000-000000000000",
            ["0"],
            ["0"],
            [
                "1",
                [
                    "1",
                    "2",
                    ["-3"],
                    guid_block,
                    props_block,
                    ["-2"],
                    guid_block,
                    props_block
                ]
            ],
            ["0", ["0"]],
            "0"
        ],
        "4"
    ]
    # Добавить список GUID значений
    for g in guid_values:
        header.append([g, "0"])
    # Добавить блок описания значений
    value_block = [
        guid_block,
        "3",
        []
    ]
    for i, (g, v) in enumerate(zip(guid_values, values)):
        value_block[2].append([
            str(i),
            [
                "3",
                ["1", "0", g],
                v,
                ["1", "\"ru\"", v],
                "",
                "0",
                "0",
                "00000000-0000-0000-0000-000000000000",
                "0"
            ],
            "0"
        ])
    header.append(value_block)
    return {
        "name": name,
        "name2": {"ru": name_ru},
        "comment": f"Автоматически создано скриптом add_enum.py",
        "header": header,
        "obj_version": "803"
    }

def add_value(enum_path, value_name):
    data = load_json(enum_path)
    h = data['header']
    # Найти блок описания значений (последний элемент header)
    value_block = h[-1]
    values = value_block[2]
    new_guid = gen_guid()
    new_idx = str(len(values))
    # Добавить описание значения
    values.append([
        new_idx,
        [
            "3",
            ["1", "0", new_guid],
            value_name,
            ["1", "\"ru\"", value_name],
            "",
            "0",
            "0",
            "00000000-0000-0000-0000-000000000000",
            "0"
        ],
        "0"
    ])
    # Добавить GUID в список предопределённых GUID
    h.insert(-1, [new_guid, "0"])
    # Увеличить счетчик
    h[1][14] = str(int(h[1][14]) + 1)
    save_json(enum_path, data)
    print(f"Значение {value_name} добавлено в {enum_path}")

def dump_header_structure(enum_dir, out_path='header_structure.json'):
    # Сохраняет структуру header первого найденного Enum.json для анализа
    for root, dirs, files in os.walk(enum_dir):
        for file in files:
            if file == 'Enum.json':
                enum = load_json(os.path.join(root, file))
                h = enum.get('header', [])
                def structure(obj):
                    if isinstance(obj, list):
                        return [structure(x) for x in obj]
                    return type(obj).__name__
                struct = structure(h)
                with open(out_path, 'w', encoding='utf-8') as f:
                    json.dump(struct, f, ensure_ascii=False, indent=2)
                print(f'Структура header сохранена в {out_path}')
                return
    print('Enum.json не найден')

def main():
    if len(sys.argv) < 3:
        print("Использование: python add_enum.py new <Имя> <РусскоеИмя> <Знач1> [<Знач2> ...] | add <ПутьКEnum.json> <НовоеЗначение> [--etalon-dir <ПутьКЭталону>]")
        return
    cmd = sys.argv[1]
    etalon_dir = None
    if '--etalon-dir' in sys.argv:
        idx = sys.argv.index('--etalon-dir')
        etalon_dir = sys.argv[idx+1]
        sys.argv = sys.argv[:idx]
    if cmd == 'new':
        enum_dir = etalon_dir or 'src/NLTrade_invoice/Enum'
        name = sys.argv[2]
        name_ru = sys.argv[3]
        values = sys.argv[4:]
        enum = create_enum(enum_dir, name, name_ru, values)
        out_dir = os.path.join(enum_dir, name)
        os.makedirs(out_dir, exist_ok=True)
        out_path = os.path.join(out_dir, 'Enum.json')
        save_json(out_path, enum)
        print(f"Создано перечисление {name} в {out_path}")
    elif cmd == 'add':
        enum_path = sys.argv[2]
        value_name = sys.argv[3]
        add_value(enum_path, value_name)
    else:
        print("Неизвестная команда")

if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] == 'dump-struct':
        enum_dir = sys.argv[2] if len(sys.argv) > 2 else 'src/NLTrade_Invoice_etalon/Enum'
        dump_header_structure(enum_dir)
    else:
        main()
