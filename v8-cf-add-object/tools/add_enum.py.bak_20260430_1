import json
import uuid
import sys
import os
from copy import deepcopy

def gen_guid():
    return str(uuid.uuid4())

def load_json(path):
    with open(path, encoding='utf-8') as f:
        return json.load(f)

def save_json(path, data):
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

